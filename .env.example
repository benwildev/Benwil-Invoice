# Postgres connection string (Supabase, Neon, Vercel Postgres, local, ...)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/benwil_billing?schema=public"

# Password for the admin login screen
ADMIN_PASSWORD="change-me"

# Random secret used to sign the session cookie (at least 32 characters).
# Generate one with:  openssl rand -base64 48
SESSION_SECRET="replace-with-a-long-random-string-at-least-32-chars"
