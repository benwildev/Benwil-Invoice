generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// The connection URL lives in prisma.config.ts (read from DATABASE_URL).
datasource db {
  provider = "postgresql"
}

/// A coaching center that gets billed.
model Center {
  id        String    @id @default(cuid())
  name      String
  owner     String    @default("")
  phone     String    @default("")
  address   String    @default("")
  fee       Decimal   @default(0) @db.Decimal(12, 2)
  notes     String    @default("")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  receipts  Receipt[]
}

/// A payment receipt. `center` is a snapshot of the center's details at the
/// time the receipt was issued, so old receipts don't change if the center is edited.
model Receipt {
  id          String   @id @default(cuid())
  no          String   @unique
  centerId    String
  center      Center   @relation(fields: [centerId], references: [id], onDelete: Restrict)
  centerSnap  Json     /// { name, owner, address, phone }
  date        String   /// YYYY-MM-DD
  periodStart String   @default("")
  periodEnd   String   @default("")
  items       Json     /// [{ desc, qty, price, period }]
  discount    Decimal  @default(0) @db.Decimal(12, 2)
  vatRate     Decimal  @default(0) @db.Decimal(6, 2)
  method      String   @default("Cash")
  txnId       String   @default("")
  notes       String   @default("")
  payments    Json     @default("[]") /// [{ amount, date, method, txnId }]
  total       Decimal  @default(0) @db.Decimal(12, 2)
  paid        Decimal  @default(0) @db.Decimal(12, 2)
  due         Decimal  @default(0) @db.Decimal(12, 2)
  status      String   @default("unpaid") /// paid | partial | unpaid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([centerId])
  @@index([date])
}

/// Business settings shown on every receipt. A single row with id "business".
model Setting {
  id         String   @id @default("business")
  business   String
  product    String
  address    String
  phone      String
  email      String
  website    String
  prefix     String
  periodDays Int
  monthlyFee Decimal  @db.Decimal(12, 2)
  signer     String
  notes      String
  updatedAt  DateTime @updatedAt
}
